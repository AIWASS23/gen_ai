# Copie para `.env` (na raiz do repositório) e ajuste os valores.
# Todas as variáveis usam o prefixo APP_ (ver deploy/api/config.py:Settings).

APP_ENVIRONMENT=development
APP_LOG_LEVEL=INFO

# --- Redis (cache de previsões) ---
APP_CACHE_ENABLED=true
APP_REDIS_URL=redis://redis:6379/0
APP_CACHE_TTL_SECONDS=3600

# --- Langfuse (observabilidade) ---
# Deixe APP_OBSERVABILITY_ENABLED=false para rodar sem Langfuse (modo no-op).
APP_OBSERVABILITY_ENABLED=false
APP_LANGFUSE_PUBLIC_KEY=
APP_LANGFUSE_SECRET_KEY=
# Langfuse Cloud (mais simples) ou o endereço do seu self-host (ver
# docker-compose.langfuse.yml):
APP_LANGFUSE_HOST=https://cloud.langfuse.com

# --- Administração ---
# Sem valor, o endpoint POST /v1/admin/reload-model fica desabilitado (503).
APP_ADMIN_API_KEY=

# --- CORS ---
APP_CORS_ALLOW_ORIGINS=["*"]
